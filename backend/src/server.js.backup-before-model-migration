app.post(
    "/api/auth/login",
    async (req, res) => {

        try {

            const {
                email,
                password
            } = req.body;


            const user =
                await User.findOne({
                    where: { email }
                });


            if (
                !user ||
                !await bcrypt.compare(
                    password || "",
                    user.password_hash
                )
            ) {

                return res.status(401).json({
                    message:
                        "Email atau password salah."
                });

            }


            res.json({

                token:
                    generateToken(user),

                user: {
                    id: user.id,
                    name: user.name,
                    email: user.email
                }

            });

        } catch (error) {

            res.status(500).json({
                message:
                    "Gagal login."
            });

        }

    }
);


