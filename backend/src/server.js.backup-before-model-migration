            const account =
                await Account.findOne({

                    where: {
                        id: income.account_id,
                        user_id: req.user.id
                    },

                    transaction,

                    lock:
                        transaction.LOCK.UPDATE

                });


            account.balance =
                Number(account.balance) -
                Number(income.amount);


            await account.save({
                transaction
            });


            await income.destroy({
                transaction
            });


            await transaction.commit();


            res.json({
